# Autenticação do admin — os usuários/senhas ficam na tabela "Usuario" do banco
# (veja o passo de criação em README.md). Esta chave só assina a sessão (cookie).
SESSION_SECRET="troque-por-uma-string-aleatoria-com-pelo-menos-32-caracteres"

# Constantes de negócio
NEXT_PUBLIC_WHATSAPP_NUMERO="5584994113818"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/SEU_USUARIO_AQUI"
